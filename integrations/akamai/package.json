{
    "name": "rti-cdn-integrations.akamai",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "build": "rollup -c",
        "package": "npm run build && node -e \"require('fs').copyFileSync('bundle.json','dist/bundle.json')\" && cd dist && tar -czf cheq-rti-edgeworker.tgz bundle.json main.js",
        "test": "tsc && vitest --reporter=verbose --watch false",
        "coverage": "vitest run --coverage --coverage.provider=istanbul"
    },
    "devDependencies": {
        "@rollup/plugin-node-resolve": "^15.0.0",
        "@rollup/plugin-typescript": "^11.0.0",
        "@types/node": "^26.2.0",
        "@vitest/coverage-istanbul": "4.1.6",
        "rollup": "^4.0.0",
        "tslib": "^2.6.0",
        "typescript": "^5.9.3",
        "vitest": "4.1.6"
    }
}
