{
    "compilerOptions": {
        "target": "es2021",
        "lib": ["es2021", "dom"],
        "module": "es2022",
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "isolatedModules": true,
        "allowSyntheticDefaultImports": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "types": ["vitest"]
    },
    "include": ["src/**/*.ts", "../core/**/*.ts"],
    "exclude": ["../core/**/*.test.ts", "src/**/*.test.ts"]
}
